
# %USERPROFILE%\.wslconfig

# https://learn.microsoft.com/en-us/windows/wsl/wsl-config

[wsl2]

# kernel=%SYSTEMROOT%/WSL/vmlinuz
# kernelModules=%SYSTEMROOT%/WSL/modules.vhdx
# kernelCommandLine=

memory=4GB
processors=8
swap=2GB
swapFile=%Temp%\swap.vhdx
defaultVhdSize=80000000

guiApplications=true

# nestedVirtualization=false
localhostForwarding=false

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true

